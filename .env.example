# =============================================================================
# Next.js / local development (.env.local)
# Copy this file to .env.local and fill in the values.
# =============================================================================

# Convex CLI deployment name (set automatically by `npx convex dev`)
CONVEX_DEPLOYMENT=

# Convex deployment URL for the frontend (set automatically by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=

# Convex site URL for HTTP routes (auth). Ends in .convex.site
# Set automatically by `npx convex dev`, or copy from the Convex dashboard.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public site URL used by the frontend for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Production / CI only
# =============================================================================

# Convex production deploy key — only needed for Vercel/CI builds, not local dev.
# Create at https://dashboard.convex.dev/project/settings#production-deploy-keys
CONVEX_DEPLOY_KEY=

# =============================================================================
# Convex deployment environment variables
# Set these on your Convex deployment with `npx convex env set KEY value`
# (not in .env.local — they run on the Convex backend)
# =============================================================================

# Better Auth — required
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Better Auth — base URL for auth callbacks
# Development: http://localhost:3000
# Production: your deployed app URL (e.g. https://matchscore.vercel.app)
SITE_URL=http://localhost:3000

# Stripe — Convex backend only (set per deployment with `npx convex env set`)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price and tax rate IDs live in convex/billing/stripeCatalog.ts (not env vars).

# Resend — required for sending emails to real addresses
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=

# Resend — set to "false" to deliver to real email addresses.
# Omit or leave unset to keep test mode (only Resend test addresses work).
RESEND_TEST_MODE=true

# Resend — sender address (must be from a verified domain in Resend)
# Defaults to onboarding@resend.dev if unset (fine for local test mode)
AUTH_FROM_EMAIL=Matchscore <onboarding@resend.dev>

# Very Good FFmpeg — goal highlight compilation (Convex backend only)
# Set on your Convex deployment: npx convex env set VGFFMPEG_API_KEY "..."
# Webhook base URL is derived automatically from CONVEX_CLOUD_URL (.convex.site).
VGFFMPEG_API_KEY=

# Cloudflare R2 — goal highlight video storage (Convex backend only via @convex-dev/r2)
# Create bucket + API token at https://dash.cloudflare.com → R2
# Set on your Convex deployment (dev and prod separately):
#   npx convex env set R2_BUCKET your-bucket-name
#   npx convex env set R2_ENDPOINT https://<account_id>.r2.cloudflarestorage.com
#   npx convex env set R2_ACCESS_KEY_ID ...
#   npx convex env set R2_SECRET_ACCESS_KEY ...
# Also add a bucket CORS policy allowing GET/HEAD from SITE_URL and http://localhost:3000
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
